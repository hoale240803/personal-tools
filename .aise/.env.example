# =====================================================
# CẤU HÌNH API KEY CHO HỆ THỐNG AISE (GIAI ĐOẠN 2)
# =====================================================
# Cách dùng:
# 1. Đổi tên hoặc copy file này thành `.aise/.env`
# 2. Dán Gemini API Key của bạn vào dòng GEMINI_API_KEY bên dưới

AI_PROVIDER=gemini
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# Dự phòng cho tương lai khi bạn chuyển sang Claude hoặc OpenAI Codex:
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

